#!/usr/bin/env python3
"""
Script untuk membuat repository GitHub dan push project secara otomatis.
Fitur: Auto-save token aman, perbaikan koneksi lambat, dan anti-upload script sendiri.
"""

import os
import sys
import json
import time
import subprocess
import urllib.request
import urllib.error
from getpass import getpass

# Konfigurasi
USERNAME = "masmalang"
REPO_NAME = "virtual-apk"
DESCRIPTION = "virtual Droid - Android Terminal Emulator"
PRIVATE = False
TOKEN_FILE = os.path.expanduser("~/.github_token")

def print_status(message, status="INFO"):
    """Print status dengan warna"""
    colors = {
        "INFO": "\033[94m",    # Biru
        "SUCCESS": "\033[92m",  # Hijau
        "ERROR": "\033[91m",    # Merah
        "WARNING": "\033[93m",  # Kuning
    }
    reset = "\033[0m"
    emoji = {
        "INFO": "ℹ️",
        "SUCCESS": "✅",
        "ERROR": "❌",
        "WARNING": "⚠️",
    }
    print(f"{colors.get(status, '')}{emoji.get(status, '')} {message}{reset}")

def run_command(command, show_output=True):
    """Jalankan command shell"""
    try:
        if show_output:
            result = subprocess.run(command, shell=True, check=True)
        else:
            result = subprocess.run(
                command, 
                shell=True, 
                check=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE
            )
        return True
    except subprocess.CalledProcessError as e:
        print_status(f"Command gagal: {command}", "ERROR")
        if e.stderr:
            print(e.stderr.decode())
        return False

def get_saved_or_new_token():
    """Mengambil token tersimpan atau meminta input jika belum ada"""
    if os.path.exists(TOKEN_FILE):
        try:
            with open(TOKEN_FILE, "r") as f:
                token = f.read().strip()
                if token:
                    print_status("Token GitHub dimuat dari ~/.github_token", "SUCCESS")
                    return token
        except Exception:
            pass

    token = getpass("🔑 Masukkan Personal Access Token GitHub: ").strip()
    if not token:
        print_status("Token tidak boleh kosong!", "ERROR")
        sys.exit(1)

    try:
        with open(TOKEN_FILE, "w") as f:
            f.write(token)
        os.chmod(TOKEN_FILE, 0o600)  # Hak akses aman (hanya user pemilik yang bisa baca)
        print_status("Token berhasil disimpan di ~/.github_token", "SUCCESS")
    except Exception as e:
        print_status(f"Gagal menyimpan token: {e}", "WARNING")

    return token

def setup_gitignore():
    """Memastikan file script ini dan file sensitif tidak ikut ter-upload"""
    print_status("Mengatur .gitignore...", "INFO")
    
    current_script = os.path.basename(__file__)
    
    patterns = [
        current_script,
        "*.pyc",
        "__pycache__/",
        ".env",
        "*.log"
    ]
    
    existing_patterns = set()
    if os.path.exists(".gitignore"):
        with open(".gitignore", "r") as f:
            existing_patterns = set(line.strip() for line in f if line.strip())
            
    to_add = [p for p in patterns if p not in existing_patterns]
    
    if to_add:
        with open(".gitignore", "a") as f:
            for pattern in to_add:
                f.write(f"\n{pattern}")
        print_status(f"Menambahkan {current_script} dan entri sensitif ke .gitignore", "SUCCESS")
        
    # Untrack file jika sebelumnya terlanjur masuk staging/commit
    run_command(f"git rm --cached {current_script} 2>/dev/null", show_output=False)

def create_repository(token):
    """Buat repository di GitHub menggunakan API"""
    print_status("Membuat repository di GitHub...", "INFO")
    
    url = "https://api.github.com/user/repos"
    data = json.dumps({
        "name": REPO_NAME,
        "description": DESCRIPTION,
        "private": PRIVATE,
        "auto_init": False
    }).encode('utf-8')
    
    headers = {
        "Authorization": f"token {token}",
        "Accept": "application/vnd.github.v3+json",
        "Content-Type": "application/json"
    }
    
    request = urllib.request.Request(url, data=data, headers=headers, method="POST")
    
    try:
        response = urllib.request.urlopen(request)
        if response.status == 201:
            print_status("Repository berhasil dibuat!", "SUCCESS")
            return True
    except urllib.error.HTTPError as e:
        if e.code == 422:
            print_status("Repository sudah ada, lanjut ke push...", "WARNING")
            return True
        elif e.code == 401:
            print_status("Token tidak valid! Silakan hapus file ~/.github_token lalu jalankan ulang.", "ERROR")
            return False
        else:
            error_body = e.read().decode()
            print_status(f"Gagal membuat repository: {e.code}", "ERROR")
            print(error_body)
            return False
    except Exception as e:
        print_status(f"Error: {str(e)}", "ERROR")
        return False
    
    return True

def optimize_git_network():
    """Mengoptimalkan konfigurasi Git untuk jaringan lambat/lemot"""
    print_status("Mengoptimalkan buffer dan protokol jaringan Git...", "INFO")
    
    configs = [
        'git config http.postBuffer 524288000',      # Buffer upload 500MB
        'git config http.lowSpeedLimit 1000',        # Minimum transfer speed 1KB/s
        'git config http.lowSpeedTime 60',           # Timeout 60 detik
        'git config http.version HTTP/1.1',          # HTTP/1.1 lebih stabil di jaringan labil
        'git config core.compression 9',             # Kompresi file maksimal
    ]
    
    for cmd in configs:
        run_command(cmd, show_output=False)

def setup_git():
    """Setup git configuration"""
    print_status("Mengkonfigurasi identitas Git...", "INFO")
    
    commands = [
        f'git config --global user.name "{USERNAME}"',
        f'git config --global user.email "{USERNAME}@users.noreply.github.com"',
    ]
    
    for cmd in commands:
        if not run_command(cmd, show_output=False):
            return False
            
    optimize_git_network()
    return True

def init_repository():
    """Inisialisasi repository jika belum ada"""
    if not os.path.exists(".git"):
        print_status("Menginisialisasi Git lokal...", "INFO")
        if not run_command("git init", show_output=False):
            return False
    else:
        print_status("Repository Git lokal sudah ada", "INFO")
    
    return True

def add_and_commit():
    """Add dan commit semua file"""
    setup_gitignore()
    
    print_status("Menambahkan file ke staging...", "INFO")
    if not run_command("git add .", show_output=False):
        return False
    
    print_status("Membuat commit...", "INFO")
    if not run_command('git commit -m "Initial commit: IDA Droid project"', show_output=False):
        print_status("Tidak ada perubahan baru untuk di-commit", "WARNING")
    
    return True

def set_remote_and_push(token):
    """Set remote dan push ke GitHub secara aman menggunakan credential helper & auto-retry"""
    print_status("Mengkonfigurasi autentikasi & remote repository...", "INFO")
    
    # Masukkan credential ke helper lokal (aman, tidak mengendap di URL .git/config)
    credential_input = f"protocol=https\nhost=github.com\nusername={USERNAME}\npassword={token}\n\n"
    subprocess.run(
        "git credential approve", 
        input=credential_input.encode('utf-8'), 
        shell=True, 
        stdout=subprocess.PIPE, 
        stderr=subprocess.PIPE
    )

    remote_url = f"https://github.com/{USERNAME}/{REPO_NAME}.git"
    
    run_command("git remote remove origin 2>/dev/null", show_output=False)
    if not run_command(f'git remote add origin "{remote_url}"', show_output=False):
        return False
    
    run_command("git branch -M main", show_output=False)
    
    max_retries = 5
    push_success = False
    
    print_status("Melakukan Push ke GitHub (Auto-Retry aktif)...", "INFO")
    
    for attempt in range(1, max_retries + 1):
        print_status(f"Mencoba upload (Percobaan {attempt}/{max_retries})...", "INFO")
        if run_command("git push -u origin main"):
            push_success = True
            break
        else:
            print_status(f"Gagal push pada percobaan ke-{attempt}.", "WARNING")
            if attempt < max_retries:
                time_wait = attempt * 5
                print_status(f"Menunggu {time_wait} detik sebelum mencoba lagi...", "INFO")
                time.sleep(time_wait)
                
    return push_success

def main():
    """Fungsi utama"""
    print("=" * 50)
    print("🚀 GitHub Repository Creator & Pusher (Optimized & Secure)")
    print("=" * 50)
    
    token = get_saved_or_new_token()
    
    if not create_repository(token):
        sys.exit(1)
    
    if not setup_git():
        sys.exit(1)
    
    if not init_repository():
        sys.exit(1)
    
    if not add_and_commit():
        sys.exit(1)
    
    if not set_remote_and_push(token):
        print_status("Gagal melakukan push setelah beberapa kali percobaan. Periksa koneksi internet Anda.", "ERROR")
        sys.exit(1)
    
    print("")
    print_status("Semua proses selesai!", "SUCCESS")
    print_status(f"Repository URL: https://github.com/{USERNAME}/{REPO_NAME}", "INFO")
    print("=" * 50)

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\n\n❌ Dibatalkan oleh user")
        sys.exit(1)
